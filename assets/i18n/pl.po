msgstr[2] "Uporządkuj {count} nowych utworów"

#: src/ui/uploads.rs:528 src/ui/uploads.rs:634
msgid "Place this track into one of your existing albums."
msgstr "Umieść ten utwór w jednym z istniejących albumów."

#: src/ui/uploads.rs:532 src/ui/uploads.rs:638
msgid "Place these tracks into one of your existing albums"
msgstr "Umieść te utwory w jednym z istniejących albumów"

#: src/ui/uploads.rs:539 src/ui/uploads.rs:632
msgid "Add to an existing album"
msgstr "Dodaj do istniejącego albumu"

#: src/ui/uploads.rs:550
msgid "Upload as Single"
msgstr "Prześlij jako singiel"

#: src/ui/uploads.rs:553
msgid "Upload as an individual Single. You can turn it into an album later."
msgstr "Prześlij jako osobny singiel. Później możesz zmienić go w album."

#: src/ui/uploads.rs:643 src/ui/uploads.rs:1559
msgid "Move to another album"
msgstr "Przenieś do innego albumu"

#: src/ui/uploads.rs:644
msgid "Choose the album this track goes into."
msgstr "Wybierz album, do którego trafi ten utwór."

#: src/ui/uploads.rs:746
msgid "Move"
msgstr "Przenieś"

#: src/ui/uploads.rs:1103
msgid "New single"
msgstr "Nowy singiel"

#: src/ui/uploads.rs:1104
msgid "New EP"
msgstr "Nowe EP"

#: src/ui/uploads.rs:1105
msgid "New album"
msgstr "Nowy album"

#: src/ui/uploads.rs:1179
msgid "Change Image"
msgstr "Zmień obraz"

#: src/ui/uploads.rs:1188
msgid "Show spectrogram"
msgstr "Pokaż spektrogram"

#: src/ui/uploads.rs:1190
msgid "Create spectrogram"
msgstr "Utwórz spektrogram"

#: src/ui/uploads.rs:1209 src/app/uploads.rs:383 src/app/uploads.rs:692
msgid "We're generating your spectrogram artwork. It should be ready soon."
msgstr "Generujemy grafikę ze spektrogramu. Wkrótce będzie gotowa."

#: src/ui/uploads.rs:1253
msgid "Artist name"
msgstr "Nazwa wykonawcy"

#: src/ui/uploads.rs:1278
msgid "Album type"
msgstr "Typ albumu"

#: src/ui/uploads.rs:1289
msgid "EP"
msgstr "EP"

#: src/ui/uploads.rs:1311
msgid "Visibility"
msgstr "Widoczność"

#: src/ui/uploads.rs:1324
msgid "Discoverable and streamable when at least one track is public."
msgstr ""
"Można go znaleźć i odtworzyć, gdy co najmniej jeden utwór jest publiczny."

#: src/ui/uploads.rs:1332
msgid "Unlisted"
msgstr "Niepubliczny"

#: src/ui/uploads.rs:1336
msgid ""
"Only visible to you and anyone with the link. Hidden from profiles when all "
"tracks are private."
msgstr ""
"Widoczny tylko dla Ciebie i osób z linkiem. Ukryty w profilach, gdy "
"wszystkie utwory są prywatne."

#: src/ui/uploads.rs:1354
msgid ""
"This album contains tracks that are still being uploaded or scanned. You can "
"change visibility once all tracks have finished scanning."
msgstr ""
"Ten album zawiera utwory, które są jeszcze przesyłane lub skanowane. "
"Widoczność można zmienić, gdy skanowanie wszystkich utworów się zakończy."

#: src/ui/uploads.rs:1371
msgid "Artwork created from the unique characteristics of your track"
msgstr "Grafika utworzona na podstawie unikalnych cech Twojego utworu"

#: src/ui/uploads.rs:1439
msgid "Add tracks"
msgstr "Dodaj utwory"

#: src/ui/uploads.rs:1455
msgid "This album has no tracks"
msgstr "Ten album nie zawiera utworów"

#: src/ui/uploads.rs:1496
msgid "Preparing..."
msgstr "Przygotowywanie..."

#: src/ui/uploads.rs:1499
#, rust-format
msgid "Uploading ({percent}%)..."
msgstr "Przesyłanie ({percent}%)..."

#: src/ui/uploads.rs:1507
msgid "Scanning…"
msgstr "Skanowanie…"

#: src/ui/uploads.rs:1510
msgid "Flagged"
msgstr "Oflagowano"

#: src/ui/uploads.rs:1511
msgid "Error uploading file"
msgstr "Błąd podczas przesyłania pliku"

#: src/ui/uploads.rs:1552 src/ui/uploads.rs:1787
msgid "Edit track details"
msgstr "Edytuj szczegóły utworu"

#: src/ui/uploads.rs:1568
msgid "Copy track link"
msgstr "Kopiuj link do utworu"

#: src/ui/uploads.rs:1576
msgid "Delete track"
msgstr "Usuń utwór"

#: src/ui/uploads.rs:1719
msgid "Edit name"
msgstr "Edytuj nazwę"

#: src/ui/uploads.rs:1727
msgid "This name will be used on your profile and all of your tracks."
msgstr ""
"Ta nazwa będzie używana w Twoim profilu i przy wszystkich Twoich utworach."

#: src/app/uploads.rs:166
msgid "The file is currently uploading. Wait until it's finished."
msgstr "Plik jest właśnie przesyłany. Poczekaj, aż się zakończy."

#: src/app/uploads.rs:177
msgid "Choose a JPEG or PNG image."
msgstr "Wybierz obraz JPEG lub PNG."

#: src/app/uploads.rs:201
msgid "Before uploading, let us know what name to release your music under."
msgstr "Zanim prześlesz muzykę, podaj nazwę, pod którą ma zostać wydana."

#: src/app/uploads.rs:209
msgid "Your TIDAL artist profile isn't loaded yet. Try again in a moment."
msgstr ""
"Twój profil wykonawcy TIDAL nie został jeszcze wczytany. Spróbuj ponownie za "
"chwilę."

#: src/app/uploads.rs:224
msgid "This file format isn't supported."
msgstr "Ten format pliku nie jest obsługiwany."

#: src/app/uploads.rs:250
msgid "Untitled"
msgstr "Bez tytułu"

#: src/app/uploads.rs:497
msgid "Upload deleted"
msgstr "Usunięto przesłany plik"

#: src/app/uploads.rs:780 src/app/uploads.rs:802 src/app/uploads.rs:805
msgid "Upload failed. Please try again."
msgstr "Przesyłanie nie powiodło się. Spróbuj ponownie."

#: src/app/uploads.rs:820
msgid "Upload complete"
msgstr "Przesyłanie zakończone"

#: src/app/uploads.rs:868
msgid "Couldn't save your changes. Try again."
msgstr "Nie udało się zapisać zmian. Spróbuj ponownie."

