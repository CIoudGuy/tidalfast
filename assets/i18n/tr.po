msgstr "Tüm parçalar için aynı ses seviyesini ayarla."

#: src/ui/settings.rs:625
msgid "Adjust the length of fading and overlap in between tracks."
msgstr "Parçalar arasındaki geçiş ve örtüşme süresini ayarla."

